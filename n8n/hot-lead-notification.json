{
  "name": "AI Reception Lite - Hot Lead Notification",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "ai-reception-lite-hot-lead",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "8af4ef14-a17b-43de-b3b0-fb00af8e7f75",
      "name": "Hot Lead Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "jsCode": "const body = $json.body || $json;\nconst headers = $json.headers || {};\nreturn [{\n  json: {\n    secret: headers['x-ai-reception-secret'] || headers['X-Ai-Reception-Secret'],\n    event: body.event,\n    lead: body.lead,\n    business: body.business,\n    createdAt: body.createdAt,\n    message: `Hot lead received: ${body.lead?.name || 'Unknown lead'}\\nBusiness: ${body.business?.name || 'Unknown business'}\\nService: ${body.lead?.requestedService || 'Unknown service'}\\nSuggested action: ${body.lead?.suggestedNextAction || 'review'}\\nSummary: ${body.lead?.summary || 'No summary'}\\nContact: ${body.lead?.email || 'no email'} / ${body.lead?.phone || 'no phone'}`\n  }\n}];"
      },
      "id": "e7c7d2aa-e2b2-4107-a845-f984ed21af60",
      "name": "Normalize Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [240, 0]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "d4f4c477-3376-43af-bbdb-7ea90502cb61",
              "leftValue": "={{ $json.event }}",
              "rightValue": "lead.hot",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            },
            {
              "id": "de93e672-b6ef-42af-80bd-fd0c613d396c",
              "leftValue": "={{ $json.secret }}",
              "rightValue": "={{ $env.N8N_WEBHOOK_SECRET }}",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "93d2e723-2822-4db0-a850-b20730f27376",
      "name": "Is Authorized Hot Lead?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [480, 0]
    },
    {
      "parameters": {
        "sendTo": "sales@example.com",
        "subject": "=Hot lead: {{ $json.lead.name }}",
        "message": "={{ $json.message }}",
        "options": {}
      },
      "id": "9f9bb4e9-fd88-4f32-bd83-0a72fbf39a1d",
      "name": "Send Email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [720, -120],
      "credentials": {
        "smtp": {
          "id": "REPLACE_WITH_SMTP_CREDENTIAL_ID",
          "name": "SMTP Account"
        }
      }
    },
    {
      "parameters": {
        "authentication": "accessToken",
        "channel": "#sales",
        "text": "={{ $json.message }}",
        "otherOptions": {}
      },
      "id": "c56a7c39-f3ef-4d61-9131-139a4f320dc5",
      "name": "Post to Slack",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.2,
      "position": [720, 120],
      "credentials": {
        "slackApi": {
          "id": "REPLACE_WITH_SLACK_CREDENTIAL_ID",
          "name": "Slack Account"
        }
      },
      "disabled": true
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "{\"success\":true}",
        "options": {}
      },
      "id": "14237233-c848-42f5-8dbe-c20cd059edc9",
      "name": "Respond OK",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [960, 0]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "{\"success\":false,\"error\":\"unauthorized_or_ignored_event\"}",
        "options": {
          "responseCode": 401
        }
      },
      "id": "96da7252-b635-4f36-b671-21333840b799",
      "name": "Respond Rejected",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [720, 300]
    }
  ],
  "pinData": {},
